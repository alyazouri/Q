// ============================================================
//  PAC Script (نسخة متقدمة) — كل الترافيك عبر بروكسي،
//  مع قائمة بالنطاقات الأردنية السكنية كمرجع/لتخصيص مستقبلي
// ============================================================

function FindProxyForURL(url, host) {

    host = host.toLowerCase();

    // ----------------------------------------------------------
    //  النطاقات الأردنية السكنية (مرجع — مزودي الخدمة الرئيسيين)
    //  Orange Jordan  = Jordan Telecom Group (Orange)
    //  Zain Jordan    = زين الأردن (MTC سابقاً)
    //  Umniah         = أمنية
    //  ملاحظة: هذه قائمة تمثيلية، النطاقات الفعلية تتغير وتتوسّع.
    // ----------------------------------------------------------

    var JO_RANGES = [
        // --- Orange Jordan (ADSL / Residential) ---
        ["92.253.64.0",  "255.255.192.0"],   // 92.253.64.0/18
        ["94.249.0.0",   "255.255.192.0"],   // 94.249.0.0/18
        ["94.249.64.0",  "255.255.192.0"],   // 94.249.64.0/18
        ["212.34.0.0",   "255.255.192.0"],   // 212.34.0.0/18
        ["212.35.64.0",  "255.255.224.0"],   // 212.35.64.0/19  (البروكسي 212.35.66.45 ضمن هذا)
        ["80.10.0.0",    "255.255.240.0"],   // 80.10.0.0/20
        ["213.139.0.0",  "255.255.0.0"],     // 213.139.0.0/16

        // --- Zain Jordan ---
        ["46.32.120.0",  "255.255.248.0"],   // 46.32.120.0/21
        ["217.23.0.0",   "255.255.0.0"],     // 217.23.0.0/16

        // --- Umniah ---
        ["5.45.128.0",   "255.255.128.0"],   // 5.45.128.0/17
        ["185.80.104.0", "255.255.248.0"]    // 185.80.104.0/21
    ];

    // ----------------------------------------------------------
    //  (اختياري) لو حبيت تعمل فحص IP للنطاقات الأردنية.
    //  بما إنك اخترت "كلشي عالبروكسي"، هاي الدالة جاهزة للتخصيص:
    // ----------------------------------------------------------
    function isJordanian(host) {
        var ip = dnsResolve(host);
        if (!ip) return false;
        for (var i = 0; i < JO_RANGES.length; i++) {
            if (isInNet(ip, JO_RANGES[i][0], JO_RANGES[i][1])) return true;
        }
        return false;
    }

    // ----------------------------------------------------------
    //  التوجيه الفعلي: كل الترافيك عبر SOCKS5 — بدون DIRECT
    // ----------------------------------------------------------
    return "SOCKS5 212.35.66.45:1080";
}
