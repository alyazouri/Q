// ================= CONFIGURATION =================

var CONFIG = {
  enableMiddleEast: false,  // تفعيل النطاقات الإقليمية
  allowIPv4: true,          // السماح بـ IPv4
  debugMode: false          // وضع التشخيص
};

// ================= HELPER FUNCTIONS =================

function ipToNumber(ip) {
  if (!ip) return 0;
  var parts = ip.split(".");
  if (parts.length !== 4) return 0;
  
  var result = 0;
  for (var i = 0; i < 4; i++) {
    var num = parseInt(parts[i], 10);
    if (isNaN(num) || num < 0 || num > 255) return 0;
    result = (result << 8) | num;
  }
  return result >>> 0;
}

function parseCIDR(cidr) {
  if (!cidr) return null;
  
  var parts = cidr.split("/");
  if (parts.length !== 2) return null;
  
  var ip = parts[0];
  var prefix = parseInt(parts[1], 10);
  
  if (isNaN(prefix) || prefix < 0 || prefix > 32) return null;
  
  var ipNum = ipToNumber(ip);
  if (ipNum === 0) return null;
  
  var mask = prefix === 0 ? 0 : (~0 << (32 - prefix)) >>> 0;
  
  return {
    network: (ipNum & mask) >>> 0,
    mask: mask,
    prefix: prefix
  };
}

function isInCIDR(ip, cidr) {
  var ipNum = ipToNumber(ip);
  if (ipNum === 0) return false;
  
  var range = parseCIDR(cidr);
  if (!range) return false;
  
  return (ipNum & range.mask) >>> 0 === range.network;
}

function isJordanIP(ip) {
  if (!ip) return false;
  
  for (var i = 0; i < JORDAN_IPV4_RANGES.length; i++) {
    if (isInCIDR(ip, JORDAN_IPV4_RANGES[i])) {
      return true;
    }
  }
  
  return false;
}

function isMiddleEastIP(ip) {
  if (!ip || !CONFIG.enableMiddleEast) return false;
  
  for (var region in MIDDLE_EAST_IPV4) {
    if (MIDDLE_EAST_IPV4.hasOwnProperty(region)) {
      var ranges = MIDDLE_EAST_IPV4[region];
      for (var i = 0; i < ranges.length; i++) {
        if (isInCIDR(ip, ranges[i])) {
          return true;
        }
      }
    }
  }
  
  return false;
}

function isPUBG(host, url) {
  if (!host) return false;
  var combined = (host + (url || "")).toLowerCase();
  return /pubg|tencent|krafton|lightspeed|levelinfinite|anticheat|tpgbattle/i.test(combined);
}

function isMatchTraffic(data) {
  if (!data) return false;
  return /match|battle|classic|ranked|arena|tdm|gungame|payload|metro|zombie|evoground|erangel|livik|miramar|sanhok|vikendi|karakin|nusa|rondo|hawan|gamesvr|relay|realtime|ingame/i.test(data.toLowerCase());
}

function isLobbyTraffic(data) {
  if (!data) return false;
  return /lobby|login|auth|profile|inventory|store|shop|region|gateway|session|friends|clan|rp|events|mission/i.test(data.toLowerCase());
}

function safeDnsResolve(host) {
  try {
    return dnsResolve(host);
  } catch (e) {
    return "";
  }
}

// ================= MAIN PROXY FUNCTION =================

function FindProxyForURL(url, host) {
  SESSION.connectionCount++;
  
  var ip = safeDnsResolve(host);
  
  // Non-PUBG traffic
  if (!isPUBG(host, url)) {
    return DIRECT;
  }
  
  // No IP resolved
  if (!ip) {
    return PROXY;
  }
  
  // Check Jordan IP
  if (isJordanIP(ip)) {
    return PROXY;
  }
  
  // Check Middle East IP (if enabled)
  if (isMiddleEastIP(ip)) {
    return PROXY;
  }
  
  // Block other IPs
  return BLOCK;
}

// ================= UTILITY FUNCTIONS =================

function getStats() {
  return {
    jordanRanges: JORDAN_IPV4_RANGES.length,
    sessionConnections: SESSION.connectionCount
  };
}

