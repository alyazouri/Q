// ─────────────────────────────────────────────
// فحص الأردن
// ─────────────────────────────────────────────
function isJordanIP(ip) {
  if (!ip) return false;
  var i;

  if (isIPv6(ip)) {
    var low = ip.toLowerCase();
    for (i = 0; i < JORDAN_IPV6.length; i++) {
      if (low.indexOf(JORDAN_IPV6[i]) === 0) return true;
    }
  } else if (isIPv4(ip)) {
    for (i = 0; i < JORDAN_IPV4.length; i++) {
      if (ip.indexOf(JORDAN_IPV4[i]) === 0) return true;
    }
  }
  return false;
}

