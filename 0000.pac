// ─────────────────────────────────────────────
// فحص الحظر — الأردن معفى دائماً
// ─────────────────────────────────────────────
function isBlockedRegion(ip) {
  // الأردن لا يُحظر أبداً
  if (isJordanIP(ip)) return false;

  var i;
  var low = ip.toLowerCase();

  if (isIPv6(ip)) {
    for (i = 0; i < BLOCKED_IPV6_PREFIXES.length; i++) {
      if (low.indexOf(BLOCKED_IPV6_PREFIXES[i]) === 0) return true;
    }
  } else if (isIPv4(ip)) {
    for (i = 0; i < BLOCKED_IPV4_PREFIXES.length; i++) {
      if (ip.indexOf(BLOCKED_IPV4_PREFIXES[i]) === 0) return true;
    }
  }

  // كل IP غير معروف وغير أردني = محظور
  return true;
}

// ============================================================
// ============================================================
// 🚀 MAIN ROUTING — Jordan Absolute Logic
// ============================================================
// ============================================================

function FindProxyForURL(url, host) {

  // ── الشبكة المحلية — مباشر ──────────────────────────────
  if (isPlainHostName(host)                             ||
      isInNet(host, "10.0.0.0",    "255.0.0.0")        ||
      isInNet(host, "172.16.0.0",  "255.240.0.0")      ||
      isInNet(host, "192.168.0.0", "255.255.0.0")      ||
      isInNet(host, "127.0.0.0",   "255.0.0.0")        ||
      isInNet(host, "169.254.0.0", "255.255.0.0")) {
    return DIRECT;
  }

  // ── غير PUBG — مباشر بدون تدخل ─────────────────────────
  if (!isPUBG(host)) {
    return DIRECT;
  }

  // ── حل DNS (IPv6 أولاً) ─────────────────────────────────
  var ip = resolveIP(host);

  // ── DNS فشل كلياً ───────────────────────────────────────
  // نوجّه عبر Proxy حتى يتمكن الـ VPN من حله
  if (!ip || ip === '') {
    return PROXY;
  }

  // ============================================================
  // 🇯🇴 الأردن؟ → PROXY فوراً
  // ============================================================
  if (isJordanIP(ip)) {
    return PROXY;
  }

  // ============================================================
  // 🚫 أي شيء آخر → BLOCK
  // الخليج | مصر | أوروبا | آسيا | أمريكا | غير محدد
  // ============================================================
  return BLOCK;
}

// ============================================================
// 📋 VERSION & BUILD
// ============================================================
// PUBG MOBILE — JORDAN ABSOLUTE v12.0
//
// 🇯🇴 JORDAN ONLY MODE:
//   ✅ Match Server     → Jordan ONLY
//   ✅ Matchmaking      → Jordan ONLY
//   ✅ Team/Squad Find  → Jordan ONLY
//   ✅ Recruit Players  → Jordan ONLY
//   ✅ Lobby            → Jordan ONLY
//   ✅ CDN / Assets     → Jordan ONLY
//   ✅ API / Backend    → Jordan ONLY
//
// 🚫 BLOCKED:
//   ❌ Gulf (SA/UAE/BH/KW/QA/OM)
//   ❌ Egypt
//   ❌ Europe
//   ❌ Far Asia (CN/JP/KR/IN/SG)
//   ❌ Americas
//   ❌ Unknown IPs
//
// 🔧 LOGIC:
//   IP أردني؟   → PROXY ✅
//   IP غير أردني؟ → BLOCK 🚫
// ============================================================
