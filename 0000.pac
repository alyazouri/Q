// كل نطاقات PUBG Mobile المعروفة
// ============================================================

var PUBG_DOMAINS = [
  // ── الشركات الأم ──────────────────────────────
  'pubg',
  'pubgmobile',
  'battlegrounds',
  'krafton',
  'tencent',
  'tencentgames',
  'lightspeedgames',
  'levelinfinite',
  'proximabeta',

  // ── خوادم اللعب الأساسية ──────────────────────
